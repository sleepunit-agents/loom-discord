#!/usr/bin/env python3
"""loom-discord: loom's Discord venue adapter (loom docs/specs/agent-runtime.md, "The sources").

    loom-discord run                         the poller (the piece's service): shadow or live, by DISCORD_MODE
    loom-discord send --place P --agent A    the venue's `send` (the runtime runs it): the text on stdin, posted as
                                             that agent's own bot; answers {ok, id?} or {ok: false, reason,
                                             permanent?} (permanent: no retry will ever post it)
        … --describe                         the place's rules, for a body's start: {ok, guest, peer, venue,
                                             readers, notes, pair?} (posts nothing; shadow too)
        … --status working|done [--message ID]...   a body at work there (the runtime's word): the run loop shows
                                             it (typing, 👀); answers {ok, stop?} (stop: a person said the stop word)
    loom-discord compare --start T --adapter GLOB --bridge GLOB [--hours 24] [--json]
                                             the shadow window: this adapter's log against the old bridge's
    loom-discord status [--json]             the mode, the agents, the log's size, how many are held (no ids, no text)

Shadow (the default): it receives and routes, records nothing and posts nothing, and logs (message id, agent,
place) for each message it would deliver. Live: each routed message goes to loom's `deliver`, and `send` posts.
"""
import json
import os
import sys
import time
import urllib.error
from pathlib import Path

HERE = Path(os.path.realpath(__file__)).parent
sys.path.insert(0, str(HERE.parent / "lib"))

from loomvenue import common  # noqa: E402
from loomdiscord import adapter, routing  # noqa: E402

PIECE = "discord"
MAX_POST = 2000
TYPING_EVERY_S = 8


def config(env=None):
    env = os.environ if env is None else env
    home = env.get("LOOM_PIECE_HOME") or str(Path.home() / ".local/state/loom-discord")
    return {
        "mode": common.mode_setting(env, "DISCORD_MODE"),
        "bots": common.bots_setting(env, "DISCORD_BOTS"),
        "data": common.setting(env, "DISCORD_DATA", str(Path(home) / "data")),
        "poll_s": float(common.setting(env, "DISCORD_POLL_S", "30")),
        "routes": common.argv_setting(env, "DISCORD_ROUTES_COMMAND",
                                      ["loom", "shuttle", "routes", "--agent", "{agent}", "--json"]),
        "gates": common.argv_setting(env, "DISCORD_GATES_COMMAND",
                                     ["loom", "runtime", "gates", "people", "--agent", "{agent}", "--json"]),
        "may": common.argv_setting(env, "DISCORD_SECRETS_MAY", ["loom", "secrets", "may", "{agent}", "{name}", "--json"]),
        "get": common.argv_setting(env, "DISCORD_SECRETS_GET", ["loom", "secrets", "get", "{name}", "--reveal"]),
        "loom_url": common.setting(env, "DISCORD_LOOM_URL", "http://127.0.0.1:8787"),
        "token_file": common.setting(env, "DISCORD_TOKEN_FILE"),
        "alert": common.alert_setting(env, "DISCORD_ALERT_COMMAND"),
    }


def under_loom(env=None):
    """Whether loom runs this as the discord piece (its settings are in the environment)."""
    return (os.environ if env is None else env).get("LOOM_PIECE_NAME") == PIECE


def reexec_under_loom(argv):
    """Run by something other than loom's piece dispatch (the runtime runs a venue's `send` by its bin name):
    go through `loom discord …`, so the piece's own settings apply."""
    loom = os.environ.get("LOOM_BIN") or "loom"
    os.execvp(loom, [loom, PIECE, *argv])


def make_views(cfg, docs):
    def views(agent):
        r, g = docs[agent]
        routes, gates = r.doc(), g.doc()
        if routes is None or gates is None:
            return None
        return routing.View(agent, routes, gates)
    return views


def make_sink(cfg, deliverer=None, alerter=None):
    """The live sink: True (loom took it, or refused it for good), False (next tick), or common.HOLD (loom refused
    how this adapter wrote it: held and alerted, tried again once the adapter restarts; common.verdict)."""
    deliverer = deliverer or common.Deliverer(cfg["loom_url"], cfg["token_file"])
    alerter = alerter or common.Alerter(cfg.get("alert"))

    def sink(agent, msg, chan, hit, label):
        status, ans = deliverer.deliver(adapter.body_of(agent, msg, chan, hit, label))
        v = common.verdict(status, ans)
        err = str(ans.get("error"))[:200]
        if v == common.DONE:
            common.log(f"{agent}: delivered {msg['id']} to {ans.get('conversation')} seq {ans.get('seq')}: {ans.get('body')}")
            return True
        if v == common.FINAL:
            # Refused for good, about this message (loom keeps no answer for it): the same body is refused again.
            common.log(f"{agent}: deliver {msg['id']} REFUSED {status}: {err}; not retried")
            return True
        if v == common.HOLD:
            common.log(f"{agent}: deliver {msg['id']} HELD {status}: {err}; loom refused how this adapter wrote it: "
                       "kept, and tried again once the adapter is updated (restarted)")
            alerter.alert("hold", adapter.SOURCE, "bad",
                          f"loom-discord: loom refused a delivery as malformed ({status}); messages are held, "
                          "not lost, until the adapter is fixed and restarted",
                          status=status, error=err, message=msg["id"], agent=agent)
            return common.HOLD
        common.log(f"{agent}: deliver {msg['id']}: {status or 'no answer'} {err}; next tick")
        return False
    return sink


def run(cfg):
    secrets = common.Secrets(cfg["may"], cfg["get"])
    apis, docs = {}, {}
    for agent, name in sorted(cfg["bots"].items()):
        try:
            apis[agent] = adapter.Discord(secrets.get(agent, name))
        except common.SecretRefused as e:
            common.log(f"{agent}: no bot: {e}")
            continue
        docs[agent] = (common.Doc(common.fill(cfg["routes"], agent=agent), what=f"{agent}'s route map"),
                       common.Doc(common.fill(cfg["gates"], agent=agent), what=f"{agent}'s gates"))
    if not apis:
        common.log("no agent's bot could be read; nothing to poll")
        return 1
    if cfg["mode"] == "live" and not cfg["token_file"]:
        common.log("live mode needs DISCORD_TOKEN_FILE (a piece token of this piece's, to deliver with)")
        return 1
    shadow = common.ShadowLog(cfg["data"], "discord")
    alerter = common.Alerter(cfg["alert"])
    a = adapter.Adapter(cfg["data"], apis, make_views(cfg, docs), shadow, alerter=alerter,
                        sink=None if cfg["mode"] == "shadow" else make_sink(cfg, alerter=alerter))
    if a.state["held"] and cfg["mode"] == "live":
        common.log(f"{len(a.state['held'])} held deliveries from before this start: trying them again")
    common.log(f"loom-discord: {cfg['mode']} for {', '.join(sorted(apis))}, every {cfg['poll_s']:g}s")
    while True:
        started = time.time()
        n = a.tick()
        if n:
            common.log(f"{'would deliver' if cfg['mode'] == 'shadow' else 'delivered'} {n}")
        # Between polls, live: what the runtime says of its bodies at work, shown (Discord's typing lasts ~10 s).
        end = started + max(1.0, cfg["poll_s"])
        while time.time() < end:
            if cfg["mode"] == "live":
                try:
                    a.show()
                except Exception as e:  # noqa: BLE001 - presence never stops the poller
                    common.log(f"presence: {type(e).__name__}")
            time.sleep(max(0.5, min(TYPING_EVERY_S, end - time.time())))


def chunks(text, n=MAX_POST):
    out = []
    while text:
        if len(text) <= n:
            out.append(text)
            break
        cut = text.rfind("\n", 0, n)
        cut = cut if cut > n // 2 else n
        out.append(text[:cut])
        text = text[cut:].lstrip("\n")
    return out


def refused_for_good(e):
    """A post Discord refused that no retry will change: a 4xx (an unknown channel, a missing permission, a bad
    token, a body Discord won't take). A rate limit, a timeout, a 5xx or the network is for now."""
    return isinstance(e, urllib.error.HTTPError) and 400 <= e.code < 500 and e.code not in (408, 429)


def send(cfg, argv, stdin=None, secrets=None, api_for=None):
    """{ok, id?} | {ok: false, reason, permanent?}: the text on stdin, posted to the place as the agent's own bot.
    `permanent: true` is a refusal for good (agent-runtime.md, "Outbound"): the runtime doesn't retry it or keep it
    for a body, it records it refused. A refusal that may pass later (a rate limit, Discord down, a secret the
    owner hasn't allowed yet) says no `permanent`."""
    def answer(d):
        print(json.dumps(d))
        return 0 if d.get("ok") else 1

    def never(reason):
        return answer({"ok": False, "reason": reason, "permanent": True})
    try:
        place = argv[argv.index("--place") + 1]
        agent = argv[argv.index("--agent") + 1]
    except (ValueError, IndexError):
        return never("usage: loom-discord send --place <place> --agent <agent>")
    if "--describe" in argv:
        return answer(describe(cfg, agent, place))
    if "--status" in argv:
        i = argv.index("--status")
        state = argv[i + 1] if i + 1 < len(argv) else ""
        msgs = [argv[j + 1] for j, x in enumerate(argv) if x == "--message" and j + 1 < len(argv)]
        return answer(common.Presence(cfg["data"]).status(agent, place, state, msgs))
    if cfg["mode"] != "live":
        return never("loom-discord is in shadow mode: it posts nothing")
    kind, _, cid = place.partition(":")
    if kind not in ("channel", "thread") or not cid.isdigit():
        return never(f"not a Discord place: {place[:80]}")
    name = cfg["bots"].get(agent)
    if not name:
        return never(f"no Discord bot for {agent}")
    try:
        token = (secrets or common.Secrets(cfg["may"], cfg["get"])).get(agent, name)
    except common.SecretRefused as e:
        return answer({"ok": False, "reason": f"{agent}'s bot: {e}"})
    text = (stdin if stdin is not None else sys.stdin).read()
    if not text.strip():
        return never("nothing to send")
    api = (api_for or adapter.Discord)(token)
    first = None
    try:
        for part in chunks(text):
            got = api.post(cid, part) or {}
            first = first or got.get("id")
    except Exception as e:  # noqa: BLE001 - the runtime gets a reason, never a trace
        reason = f"Discord refused the post: {type(e).__name__} {getattr(e, 'code', '')}".strip()
        return never(reason) if refused_for_good(e) else answer({"ok": False, "reason": reason})
    common.Presence(cfg["data"]).posted(agent, place)   # the reply is the acknowledgment: 👀 comes off
    return answer({"ok": True, **({"id": str(first)} if first else {})})


def describe(cfg, agent, place, docs=None):
    """The place's rules, from the agent's route map and gates (the same reads routing uses: either unreadable is
    {ok: false}, so the runtime starts no body there) and the poller's memory of which channel a thread is under."""
    if agent not in cfg["bots"]:
        return {"ok": False, "reason": f"no Discord bot for {agent}"}
    r, g = docs or (common.Doc(common.fill(cfg["routes"], agent=agent), what=f"{agent}'s route map"),
                    common.Doc(common.fill(cfg["gates"], agent=agent), what=f"{agent}'s gates"))
    routes, gates = r.doc(), g.doc()
    if routes is None or gates is None:
        return {"ok": False, "reason": f"{agent}'s route map or gates can't be read"}
    parents = (common.load_json(Path(cfg["data"]) / "state.json", {}) or {}).get("parents") or {}
    chan = routing.chan_of(place, parents)
    if chan is None:
        return {"ok": False, "reason": f"not a Discord place this adapter knows: {place[:80]}"}
    return routing.View(agent, routes, gates).describe(chan)


def status(cfg, as_json):
    p = Path(cfg["data"]) / common.ShadowLog.NAME
    try:
        n = sum(1 for _ in p.open())
    except OSError:
        n = 0
    st = common.load_json(Path(cfg["data"]) / "state.json", {}) or {}
    held = len(st.get("held") or {})
    d = {"mode": cfg["mode"], "agents": sorted(cfg["bots"]), "shadow_lines": n, "held": held}
    print(json.dumps(d) if as_json else f"{d['mode']}: {', '.join(d['agents']) or 'no agents'}; {n} shadow lines; "
          f"{held} held")
    return 0


def main(argv):
    verb = argv[0] if argv else ""
    if verb in ("send", "run", "status") and not under_loom():
        reexec_under_loom(argv)
    if verb == "compare":
        return common.compare_main(argv[1:], "discord")
    try:
        cfg = config()
    except SystemExit as e:
        if verb == "send":   # its settings don't parse: no retry fixes that
            print(json.dumps({"ok": False, "reason": str(e), "permanent": True}))
            return 1
        raise
    if verb == "run":
        return run(cfg)
    if verb == "send":
        return send(cfg, argv[1:])
    if verb == "status":
        return status(cfg, "--json" in argv)
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
